{
  "name": "betmasterleague-server",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "clean": "rimraf ../deploy_server/ftp/backend/",
    "copy-yaml": "copyfiles docker-compose.yaml ../deploy_server/",
    "copy-files": "copyfiles -u 1 src/**/*.ejs src/*.key* src/images/ src/templates/** src/public/** ../deploy_server/ftp/backend/",
    "copy-images": "copyfiles -u 1 src/images/* ../deploy_server/ftp/backend/",
    "copy-templates": "copyfiles -u 1 src/templates/** ../deploy_server/ftp/backend/",
    "copy-public": "copyfiles -u 1 src/public/** ../deploy_server/ftp/backend/",
    "copy-packages": "copyfiles package*.json ../deploy_server/ftp/backend/",
    "copy-config": "copyfiles default.conf ../deploy_server/ftp/frontend/nginx/config",
    "build": "npm run clean && npm run copy-yaml && npm run copy-config && npm run copy-files && npm run copy-images && npm run copy-templates && npm run copy-public && npm run copy-packages && npx tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "preview": "cd ../deploy_server/ftp/backend/ && npm ci && node server.js",
    "start": "npm ci && node server.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "yamlDev": "copy /Y docker-compose.yaml.dev docker-compose.yaml",
    "yamlProd": "copy /Y docker-compose.yaml.prod docker-compose.yaml"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.3.6",
    "cheerio": "^1.2.0",
    "connect-mongo": "^5.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "handlebars": "^4.7.8",
    "hbs": "^4.2.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^7.2.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.3",
    "openai": "^7.20.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.6",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^4.17.21",
    "@types/express-ejs-layouts": "^2.5.4",
    "@types/express-session": "^1.18.0",
    "@types/handlebars": "^4.0.40",
    "@types/hbs": "^4.0.5",
    "@types/joi": "^17.2.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "copyfiles": "^2.4.1",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
